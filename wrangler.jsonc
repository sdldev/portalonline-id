{
    "main": "@astrojs/cloudflare/entrypoints/server",
    "name": "portalonline-id",
    "compatibility_date": "2026-02-27",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
    },
    "kv_namespaces": [
        {
            "binding": "CACHE_KV",
            "id": "db51254b13fe4ef5b538ac960a4ca7e3",
        },
        {
            "binding": "SESSION",
            "id": "989e0066e0884ffa9a053ea4d9a6ad83",
        },
    ],
    "observability": {
        "enabled": true,
    },
}
